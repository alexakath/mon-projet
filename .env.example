# L'application appelle Dolibarr via le proxy Vite (voir vite.config.js) :
# same-origin, pas de CORS, pas de compression gzip corrompue par les
# avertissements PHP. DOLIBARR_TARGET est l'adresse réelle du serveur.
VITE_DOLIBARR_API_URL=/dolibarr
DOLIBARR_TARGET=http://dolibarr.localhost/api/index.php

VITE_DOLAPIKEY=votre_cle_api_dolibarr
VITE_ADMIN_LOGIN=admin
VITE_ADMIN_PASSWORD=votre_mot_de_passe
